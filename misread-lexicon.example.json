{
  "roots": ["~/.claude", "~/.codex", "~/.gemini", "~/.config/github-copilot"],
  "lexicons": ["lexicon/lexicon.en.md", "lexicon/lexicon.ja.md"],
  "transcripts": "~/.claude/projects",
  "probes": "probes",
  "runner": "claude -p {prompt}",
  "scan": [
    {
      "rules": ["M1"],
      "include": [
        "AGENTS.md",
        "CLAUDE.md",
        "GEMINI.md",
        "rules/**/*.md",
        "skills/**/*.md",
        "workflows/**/*.md",
        "templates/**/*.md",
        "prompts/**/*.md"
      ],
      "exclude": ["ledgers/**", "**/node_modules/**", "**/.git/**"]
    },
    {
      "rules": ["M5"],
      "include": ["**/HANDOFF.md", "AGENTS.md", "CLAUDE.md", "GEMINI.md"],
      "exclude": ["ledgers/**", "**/node_modules/**", "**/.git/**"]
    }
  ]
}
